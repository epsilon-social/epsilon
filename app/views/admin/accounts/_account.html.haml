.batch-table__row{ class: [!account.unavailable? && account.user_pending? && 'batch-table__row--attention', (account.unavailable? || account.user_unconfirmed?) && 'batch-table__row--muted'] }
  %label.batch-table__row__select.batch-table__row__select--aligned.batch-checkbox
    - if local_assigns[:f].present?
      = f.check_box :account_ids, { multiple: true, include_hidden: false }, account.id
  .batch-table__row__content.batch-table__row__content--unpadded
    %table.accounts-table
      %tbody
        %tr
          %td
            = account_link_to account, path: admin_account_path(account.id)
          %td.accounts-table__count.optional
            - if account.unavailable? || account.user_pending?
              \-
            - else
              = friendly_number_to_human account.statuses_count
            %small= t('accounts.posts', count: account.statuses_count)
          %td.accounts-table__count.optional
            - if account.unavailable? || account.user_pending?
              \-
            - else
              = friendly_number_to_human account.followers_count
            %small= t('accounts.followers', count: account.followers_count)
          -# EPSILON : ADMIN ACCOUNTS FOLLOWING COUNT
          %td.accounts-table__count.optional
            - if account.unavailable? || account.user_pending?
              \-
            - else
              = friendly_number_to_human account.following_count
            %small= t('accounts.following', count: account.following_count)
          %td.accounts-table__count
            = relevant_account_timestamp(account)
            %small= t('accounts.last_active')
          %td.accounts-table__extra
            - if account.local?
              - if account.user_email
                -# EPSILON : ADMIN ACCOUNTS FULL EMAIL
                = link_to account.user_email, admin_accounts_path(email: "%@#{account.user_email_domain}"), title: account.user_email
              - else
                \-
              %br/
              %samp.ellipsized-ip= relevant_account_ip(account, params[:ip])
          -# EPSILON : SIGNUP REVIEW COLUMN
          - epsilon_review = epsilon_account_reviews[account.id]
          - epsilon_infos = epsilon_review_infos(account, epsilon_review)
          %td.accounts-table__count.epsilon-account-review{ data: { infos: epsilon_infos.presence&.join("\n"), epsilon_copy: epsilon_account_copy_line(account) } }
            - if epsilon_review.present?
              %span{ class: "epsilon-account-review__badge epsilon-account-review__badge--#{epsilon_review.status}" }= t("admin.epsilon.account_reviews.statuses.#{epsilon_review.status}")
            - else
              \-
            - if epsilon_infos.any?
              %small= t('admin.epsilon.account_reviews.infos')
    - if !account.unavailable? && account.user_pending? && account.user&.invite_request&.text.present?
      .batch-table__row__content__quote
        %p= account.user&.invite_request&.text
    -# EPSILON : SIGNUP REVIEW DETAILS
    - if epsilon_review.present? && epsilon_review.payload.present?
      .batch-table__row__content__quote.epsilon-account-review__details
        - epsilon_review.payload.each do |key, value|
          %span.epsilon-account-review__chip{ title: key }
            = value.is_a?(Enumerable) ? value.to_a.join(', ') : value.to_s
