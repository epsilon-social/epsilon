.batch-table__row{ class: [!tag.requires_review? && !tag.usable? && 'batch-table__row--muted'] }
  .batch-table__row__content.batch-table__row__content--padded.pending-account
    .pending-account__header
      %strong
        = link_to tag.formatted_name, admin_tag_path(tag.id)

      %br/

      - if tag.usable?
        = t('admin.tags.moderation.usable')
      - else
        = t('admin.tags.moderation.not_usable')

      ·
      - if tag.trendable?
        = t('admin.tags.moderation.trendable')
      - else
        = t('admin.tags.moderation.not_trendable')

      - if tag.requested_review? || tag.requires_review?
        ·
        - if tag.requested_review?
          %span.negative-hint
            = t('admin.tags.moderation.review_requested')
        - else
          %span.warning-hint
            = t('admin.tags.moderation.pending_review')

  -# EPSILON : CATEGORIZATION SYSTEM
  - assigned_ids = epsilon_category_ids_by_hashtag.fetch(tag.name, [])
  %details.epsilon-hashtag-categories{ data: { epsilon_hashtag: tag.name, epsilon_toggle_url: admin_epsilon_hashtags_categorization_toggle_path } }
    %summary.epsilon-hashtag-categories__summary
      = t('admin.epsilon.categorization.categories')
      %span.epsilon-hashtag-categories__count{ data: { epsilon_category_count: '' } }= assigned_ids.size
    .epsilon-hashtag-categories__menu
      - epsilon_categories.each do |category|
        %label.epsilon-hashtag-categories__option
          = check_box_tag "epsilon_category_#{tag.id}_#{category.id}", category.id, assigned_ids.include?(category.id), data: { epsilon_category_toggle: '', epsilon_category_name: category.name }
          %span= category.name
  -# ==========================================
