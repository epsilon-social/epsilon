.batch-table__row{ class: [tag.requires_review? && 'batch-table__row--attention', !tag.requires_review? && !tag.trendable? && 'batch-table__row--muted'] }
  %label.batch-table__row__select.batch-table__row__select--aligned.batch-checkbox
    = f.check_box :tag_ids, { multiple: true, include_hidden: false }, tag.id

  .batch-table__row__content.pending-account
    .pending-account__header
      = link_to tag.formatted_name, admin_tag_path(tag.id)

      %br/

      = link_to tag_path(tag), target: '_blank', rel: 'noopener' do
        = t('admin.trends.tags.used_by_over_week', count: tag.history.reduce(0) { |sum, day| sum + day.accounts })

      - if tag.trendable?
        ·
        %abbr{ title: t('admin.trends.tags.current_score', score: tag.trend.score) }= t('admin.trends.tags.trending_rank', rank: tag.trend.rank)

        - if tag.decaying?
          ·
          = t('admin.trends.tags.peaked_on_and_decaying', date: l(tag.max_score_at.to_date, format: :short))
      - elsif tag.requires_review?
        ·
        = t('admin.trends.pending_review')

  -# EPSILON : CATEGORIZATION SYSTEM
  - assigned_ids = epsilon_category_ids_by_hashtag.fetch(tag.name, [])
  %details.epsilon-hashtag-categories{ data: { epsilon_hashtag: tag.name, epsilon_toggle_url: admin_epsilon_hashtags_categorization_toggle_path } }
    %summary.epsilon-hashtag-categories__summary
      = t('admin.epsilon.categorization.categories')
      %span.epsilon-hashtag-categories__count{ data: { epsilon_category_count: '' } }= assigned_ids.size
    .epsilon-hashtag-categories__menu
      - epsilon_categories.each do |category|
        %label.epsilon-hashtag-categories__option
          = check_box_tag "epsilon_category_#{tag.id}_#{category.id}", category.id, assigned_ids.include?(category.id), data: { epsilon_category_toggle: '' }
          %span= category.name
  -# ==========================================
