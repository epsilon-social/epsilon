%html{ lang: I18n.locale }
  %head
    %meta{ charset: 'utf-8' }/
    %meta{ content: 'noindex', name: 'robots' }/
    %meta{ content: 'width=device-width, initial-scale=1', name: 'viewport' }/
    %title Sign-in link invalid
    :css
      body { font-family: system-ui, sans-serif; max-width: 32rem; margin: 4rem auto; padding: 0 1.5rem; text-align: center; }
  %body
    %h1 Sign-in link invalid or expired
    %p This one-time sign-in link is no longer valid. Please reopen the app to sign in again.
