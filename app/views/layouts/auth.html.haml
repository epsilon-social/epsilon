-# EPSILON: redesigned auth shell (brand aside + form card) — styling in app/javascript/styles/epsilon/auth.scss
- content_for :header_tags do
  = vite_typescript_tag 'public.tsx', crossorigin: 'anonymous'

- content_for :content do
  .container-alt.epsilon-auth{ data: { 'password-show': t('epsilon_auth.show_password', default: 'Show password'), 'password-hide': t('epsilon_auth.hide_password', default: 'Hide password') } }
    %aside.epsilon-auth__brand
      = link_to root_path, class: 'epsilon-auth__brand-lockup' do
        %span.epsilon-auth__brand-mark E
        %span.epsilon-auth__brand-name Epsilon
      %h1.epsilon-auth__brand-title= t('epsilon_auth.title')
      %p.epsilon-auth__brand-copy= t('epsilon_auth.description')
      %ul.epsilon-auth__benefits
        %li.epsilon-auth__benefit
          %span.epsilon-auth__benefit-icon= material_symbol('badge')
          %span.epsilon-auth__benefit-body
            %strong.epsilon-auth__benefit-title= t('epsilon_auth.benefit_profiles_title')
            %span.epsilon-auth__benefit-copy= t('epsilon_auth.benefit_profiles_copy')
        %li.epsilon-auth__benefit
          %span.epsilon-auth__benefit-icon= material_symbol('shield')
          %span.epsilon-auth__benefit-body
            %strong.epsilon-auth__benefit-title= t('epsilon_auth.benefit_moderation_title')
            %span.epsilon-auth__benefit-copy= t('epsilon_auth.benefit_moderation_copy')
        %li.epsilon-auth__benefit
          %span.epsilon-auth__benefit-icon= material_symbol('tune')
          %span.epsilon-auth__benefit-body
            %strong.epsilon-auth__benefit-title= t('epsilon_auth.benefit_feed_title')
            %span.epsilon-auth__benefit-copy= t('epsilon_auth.benefit_feed_copy')

    %main.form-container
      = render 'flashes'

      = yield

= render template: 'layouts/application'
