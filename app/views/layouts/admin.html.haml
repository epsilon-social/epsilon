- content_for :header_tags do
  = render_initial_state
  = vite_typescript_tag 'public.tsx', crossorigin: 'anonymous'
  = vite_typescript_tag 'admin.tsx', crossorigin: 'anonymous'

- content_for :body_classes, 'admin'

- content_for :content do
  %a.navigation-skip-link{ href: '#content' }= t('admin.skip_to_content')
  .admin-wrapper
    %header.sidebar-wrapper
      .sidebar-wrapper__inner
        .sidebar
          = link_to root_path do
            = render_logo

          .sidebar__toggle
            .sidebar__toggle__logo
              = link_to root_path do
                = logo_as_symbol(:wordmark)

            = link_to '#', class: 'sidebar__toggle__icon', 'aria-label': t('navigation.toggle_menu'), 'aria-expanded': 'false' do
              = material_symbol 'menu'
              = material_symbol 'close'

          -# EPSILON : SETTINGS NAV
          - epsilon_settings_nav_labels = { section_settings: t('admin.epsilon.settings_nav.section_settings'),
                                            section_administration: t('admin.epsilon.settings_nav.section_administration'),
                                            no_results: t('admin.epsilon.settings_nav.no_results'),
                                            toggle_section: t('admin.epsilon.settings_nav.toggle_section') }
          .epsilon-settings-nav__filter{ data: epsilon_settings_nav_labels }
            = material_symbol 'search'
            %input.epsilon-settings-nav__filter-input{ type: 'search', autocomplete: 'off', placeholder: t('admin.epsilon.settings_nav.search'), 'aria-label': t('admin.epsilon.settings_nav.search') }

          %nav
            -# EPSILON : SETTINGS NAV — expand_all renders every group up-front (1 click = 1 destination)
            = render_navigation(expand_all: true)

    %main.content-wrapper#content
      .content
        .content__heading
          - if content_for?(:heading)
            = yield :heading
          - else
            .content__heading__row
              %h1= yield :page_title

              - if content_for?(:heading_actions)
                .content__heading__actions
                  = yield :heading_actions

        = render 'application/flashes'

        = yield

    .sidebar-wrapper.sidebar-wrapper--empty

= render template: 'layouts/application'
