- content_for :page_title do
  = t('settings.delete')

-# EPSILON : account-deletion confirmation modal (App Store 5.1.1(v)).
   data-confirm-modal is intercepted in entrypoints/public.tsx to show a
   styled confirmation dialog before the account is actually deleted.
- confirm_modal_data = { confirm_modal: 'true',
                         confirm_title: t('deletes.confirm_modal.title'),
                         confirm_message: t('deletes.confirm_modal.message'),
                         confirm_confirm: t('deletes.confirm_modal.confirm'),
                         confirm_cancel: t('deletes.confirm_modal.cancel') }
= simple_form_for @confirmation, url: settings_delete_path, method: :delete, html: { data: confirm_modal_data } do |f|
  %p.hint= t('deletes.warning.before')

  %ul.hint
    - if current_user.confirmed? && current_user.approved?
      %li.warning-hint= t('deletes.warning.irreversible')
      %li.warning-hint= t('deletes.warning.username_unavailable')
      %li.warning-hint= t('deletes.warning.data_removal')
      %li.warning-hint= t('deletes.warning.caches')
    - else
      %li.positive-hint= t('deletes.warning.email_change_html', path: edit_user_registration_path)
      %li.positive-hint= t('deletes.warning.email_reconfirmation_html', path: new_user_confirmation_path)
      %li.positive-hint= t('deletes.warning.email_contact_html', email: Setting.site_contact_email)
      %li.positive-hint= t('deletes.warning.username_available')

  %p.hint= t('deletes.warning.more_details_html', terms_path: privacy_policy_path)

  %hr.spacer/

  -# EPSILON : required so the browser blocks an empty submit (App Store 5.1.1(v))
     before the confirmation modal can open.
  - if current_user.encrypted_password.present?
    = f.input :password, required: true, wrapper: :with_block_label, input_html: { autocomplete: 'current-password', required: true }, hint: t('deletes.confirm_password')
  - else
    = f.input :username, required: true, wrapper: :with_block_label, input_html: { autocomplete: 'off', required: true }, hint: t('deletes.confirm_username')

  .actions
    = f.button :button, t('deletes.proceed'), type: :submit, class: 'negative'
